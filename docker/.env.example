# Environment variables for Docker Compose
# Copy this file to .env in the docker directory and modify as needed

# MongoDB Configuration
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=secure_password_change_in_production
MONGO_DB_NAME=ehr_system

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-make-it-long-and-complex

# Service Ports (modify if ports are already in use)
MONGODB_PORT=27017
CRYPTOGRAPHY_PORT=8000
EHR_SYSTEM_PORT=3000

# Development/Production Mode
NODE_ENV=development
DEBUG=true

# Logging
LOG_LEVEL=INFO

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Docker Compose Project Name
COMPOSE_PROJECT_NAME=machs