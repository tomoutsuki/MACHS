# Environment variables for FABEO Isolated Testing
# Copy this file to .env in the docker directory and modify as needed

# Service Ports (modify if ports are already in use)
FABEO_SERVICE_PORT=8002
CRYPTO_API_PORT=8001

# Logging
LOG_LEVEL=INFO

# FABEO Service URL (for internal communication)
FABEO_SERVICE_URL=http://fabeo-service:8002

# Storage Path
STORAGE_PATH=/app/storage

# Development Mode
DEBUG=true

# Docker Compose Project Name
COMPOSE_PROJECT_NAME=machs-fabeo