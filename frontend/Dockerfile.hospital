# Hospital Frontend Dockerfile
FROM node:18-alpine

# Install curl for health checks
RUN apk add --no-cache curl

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install --only=production

# Copy application files
COPY . .

# Make initialization script executable
RUN chmod +x init-hospital.sh

# Create a non-root user
RUN addgroup -g 1001 -S nodejs
RUN adduser -S hospital -u 1001

# Change ownership of the app directory
RUN chown -R hospital:nodejs /app
USER hospital

# Expose port
EXPOSE 3002

# Environment variables
ENV CREATE_DEMO_DATA=true
ENV NODE_ENV=production

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=30s --retries=3 \
  CMD wget -q --spider http://localhost:3002/health || exit 1

# Start with initialization script
CMD ["./init-hospital.sh"]